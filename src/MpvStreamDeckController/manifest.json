            "States": [
                {
                    "Image": "Images/key/08b_acompressor_off",
                    "TitleAlignment": "middle",
                    "FontSize": 12
                },
                {
                    "Image": "Images/key/08a_acompressor_on",
                    "TitleAlignment": "middle",
                    "FontSize": 12
                }
            ],
            "DisableAutomaticStates": true,
            "SupportedInMultiActions": true,
            "Tooltip": "Toggle Acompressor",
            "PropertyInspectorPath": "PropertyInspectors/ACompressor.html",
            "UUID": "com.jkommer.mpv.toggleacompressor"
        },
        {
            "Icon": "Images/dial/09_seek_dial",
            "Name": "Seek",
            "Tooltip": "Rotate to seek in the currently playing media file, press to pause / play",
            "Controllers": [
                "Encoder"
            ],
            "Encoder": {
                "layout": "$B1",
                "TriggerDescription": {
                    "Push": "Play / Pause",
                    "Rotate": "Seek",
                    "Touch": "Play / Pause"
                }
            },
            "States": [
                {
                    "Image": "Images/dial/09_seek_dial"
                }
            ],
            "PropertyInspectorPath": "PropertyInspectors/Seek.html",
            "UUID": "com.jkommer.mpv.seek"
        },
        {
            "Name": "Custom Command",
            "UUID": "com.jkommer.mpv.customcommand",
            "Icon": "Images/key/10_custom_command",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "Images/key/10_custom_command",
                    "TitleAlignment": "middle"
                }
            ],
            "SupportedInMultiActions": true,
            "Tooltip": "Send any mpv command",
            "PropertyInspectorPath": "PropertyInspectors/CustomCommand.html"
        },
        {
            "Icon": "Images/dial/11a_volume_dial",
            "Name": "Volume",
            "Tooltip": "Rotate to change mpv's volume, press to mute",
            "Controllers": [
                "Encoder"
            ],
            "Encoder": {
                "layout": "$B1",
                "TriggerDescription": {
                    "Push": "Mute / Unmute",
                    "Rotate": "Volume",
                    "Touch": "Mute / Unmute"
                }
            },
            "States": [
                {
                    "Image": "Images/dial/11a_volume_dial"
                },
                {
                    "Image": "Images/dial/11b_volume_muted_dial"
                }
            ],
            "PropertyInspectorPath": "PropertyInspectors/Volume.html",
            "UUID": "com.jkommer.mpv.volume"
        }
    ],
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "UUID": "com.jkommer.mpv",
    "Author": "jkommer",
    "Description": "A stream deck plugin to control mpv",
    "Name": "mpv",
    "Icon": "Images/plugin/png/mpv",
    "Version": "0.0.1.0",
    "CodePath": "com.jkommer.mpv.exe",
    "Category": "mpv",
    "CategoryIcon": "Images/plugin/svg/mpv-category",
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "6.4"
    },
    "ApplicationsToMonitor": {
        "windows": [
            "mpv.exe"
        ]
    }
}