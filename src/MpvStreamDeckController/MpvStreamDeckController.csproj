<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The plugin is Windows only (see manifest.json); a fixed RID keeps the other platforms' native libraries out of the package. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Local builds use the installed .NET runtime. The GitHub build overrides this with -p:SelfContained=true, so
         released packages include the runtime (see .github/workflows/build.yml). -->
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>com.jkommer.mpv</AssemblyName>
    <OutputPath>bin\$(Configuration)\com.jkommer.mpv.sdPlugin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <ApplicationIcon>Images\plugin\mpv.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamDeck-Tools" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Images/**/*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Development material, not part of the plugin. -->
    <None Update="Images/docs/**;Images/tools/**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="PropertyInspectors\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>    
  </ItemGroup>

  <Target Name="PostClean" AfterTargets="Clean">
    <RemoveDir Directories="$(BaseOutputPath)" />
  </Target>

  <!-- Get rid of SkiaSharp pdbs which get pulled in from StreamDeck-Tools; can do without the  200+MB! -->
  <Target Name="ExcludePackagePdbs" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
